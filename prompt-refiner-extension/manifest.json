{
  "manifest_version": 3,
  "name": "Nova AI – Prompt Refiner",
  "version": "1.2.0",
  "description": "Refine rough prompts into clear, high-precision prompts using Groq, Claude, OpenAI, Gemini, and more.",
  "action": {
    "default_title": "Open Nova AI Side Panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
